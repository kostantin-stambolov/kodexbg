# --- Stripe режим ---
# sandbox | live. Ако липсва: sandbox в development, live в production.
# Локално оставяме sandbox, за да не пипаме живия Stripe.
STRIPE_MODE=sandbox

# --- Stripe ключове: LIVE ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Stripe ключове: SANDBOX ---
STRIPE_SECRET_KEY_SANDBOX=sk_test_...
# Webhook secret за sandbox. Локално: от `stripe listen` (Stripe CLI).
STRIPE_WEBHOOK_SECRET_SANDBOX=whsec_...

# --- База данни (Postgres) ---
# Локално: публичният connection string на Railway Postgres (DATABASE_PUBLIC_URL).
# В Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (вътрешна референция).
DATABASE_URL=postgres://user:pass@host:port/dbname
